# ── Core ─────────────────────────────────────────────────────────────
# Secret used to sign the anonymous session cookie (job ownership).
# REQUIRED in production. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Where uploads, outputs and temporary encoding files live.
DATA_DIR=./data

# Binaries (defaults: resolved from PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ── Limits ───────────────────────────────────────────────────────────
MAX_UPLOAD_MB=2048            # per-file upload limit
MAX_DURATION_SEC=900          # longest video accepted for processing
JOB_TIMEOUT_SEC=3600          # hard kill for a single job
MAX_CONCURRENT_JOBS=1         # FFmpeg jobs running at once (CPU bound)
MAX_QUEUED_JOBS_PER_SESSION=3
FILE_TTL_MIN=60               # files are deleted this long after creation
FFMPEG_THREADS=0              # 0 = let FFmpeg decide

# ── TikTok retrieval ─────────────────────────────────────────────────
# Metadata always comes from TikTok's official public oEmbed endpoint.
# Media retrieval needs ONE of the providers below. Nothing is faked when
# neither is configured: the UI explains that retrieval is unavailable.

# Option A — an authorized/licensed media provider you have a contract with.
# See README "Authorized provider contract".
TIKTOK_PROVIDER_URL=
TIKTOK_PROVIDER_TOKEN=

# Option B — operator opt-in public-page extractor (yt-dlp). Only public
# videos; never private/DRM content. You are responsible for compliance with
# TikTok's Terms of Service in your jurisdiction.
TIKTOK_YTDLP_ENABLED=false
YTDLP_PATH=yt-dlp
MAX_DOWNLOAD_MB=500
